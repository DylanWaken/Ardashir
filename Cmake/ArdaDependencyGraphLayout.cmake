include_guard(GLOBAL)

function(ardashir_validate_dependency_graph_layout ModuleRoot)
    foreach(Visibility Public Private)
        file(GLOB Entries CONFIGURE_DEPENDS RELATIVE "${ModuleRoot}/${Visibility}"
            "${ModuleRoot}/${Visibility}/*")
        foreach(Entry IN LISTS Entries)
            if(Entry STREQUAL "Graph" OR Entry STREQUAL "Inductor")
                continue()
            endif()
            if(Visibility STREQUAL "Public" AND Entry STREQUAL "ArdaDependencyGraph.h")
                continue()
            endif()
            message(FATAL_ERROR "Unexpected dependency graph root entry: ${Visibility}/${Entry}")
        endforeach()
        foreach(Group Graph Inductor)
            if(Group STREQUAL "Graph")
                set(Categories Resources Node DefaultNodes)
            else()
                set(Categories Config Rules Compiler Runtime)
            endif()
            file(GLOB Entries CONFIGURE_DEPENDS RELATIVE "${ModuleRoot}/${Visibility}/${Group}"
                "${ModuleRoot}/${Visibility}/${Group}/*")
            foreach(Entry IN LISTS Entries)
                if(NOT Entry IN_LIST Categories OR NOT IS_DIRECTORY "${ModuleRoot}/${Visibility}/${Group}/${Entry}")
                    message(FATAL_ERROR "Unexpected dependency graph category: ${Visibility}/${Group}/${Entry}")
                endif()
            endforeach()
        endforeach()
        file(GLOB_RECURSE ModuleFiles CONFIGURE_DEPENDS RELATIVE "${ModuleRoot}/${Visibility}"
            "${ModuleRoot}/${Visibility}/*")
        foreach(ModuleFile IN LISTS ModuleFiles)
            if(Visibility STREQUAL "Public" AND ModuleFile STREQUAL "ArdaDependencyGraph.h")
                continue()
            endif()
            if(ModuleFile MATCHES "^(Graph/(Resources|Node|DefaultNodes)|Inductor/(Config|Rules|Compiler|Runtime))/[^/]+\\.(h|cpp)$")
                continue()
            endif()
            message(FATAL_ERROR "Dependency graph file has no owning category: ${Visibility}/${ModuleFile}")
        endforeach()
    endforeach()
endfunction()
