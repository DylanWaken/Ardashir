using UnrealBuildTool;

public class ArdashirUnrealTestEditorTarget : TargetRules
{
    public ArdashirUnrealTestEditorTarget(TargetInfo Target) : base(Target)
    {
        Type = TargetType.Editor;
        DefaultBuildSettings = BuildSettingsVersion.V7;
        IncludeOrderVersion = EngineIncludeOrderVersion.Latest;
        ExtraModuleNames.Add("ArdashirUnrealTest");
    }
}
