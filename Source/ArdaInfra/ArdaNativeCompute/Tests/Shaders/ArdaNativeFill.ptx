.version 8.0
.target sm_75
.address_size 64

.visible .entry arda_native_fill(.param .u64 output, .param .u32 base)
{
    .reg .b32 index, value;
    .reg .b64 pointer, offset;
    mov.u32 index, %tid.x;
    ld.param.u32 value, [base];
    add.u32 value, value, index;
    mul.wide.u32 offset, index, 4;
    ld.param.u64 pointer, [output];
    add.u64 pointer, pointer, offset;
    st.global.u32 [pointer], value;
    ret;
}

.visible .entry arda_native_texture_add(.param .u64 data, .param .u32 row_pitch, .param .u32 addend)
{
    .reg .b32 x, y, pitch, value, delta;
    .reg .b64 pointer, row_offset, column_offset;
    mov.u32 x, %tid.x;
    mov.u32 y, %ctaid.x;
    ld.param.u32 pitch, [row_pitch];
    ld.param.u32 delta, [addend];
    ld.param.u64 pointer, [data];
    mul.wide.u32 row_offset, y, pitch;
    mul.wide.u32 column_offset, x, 4;
    add.u64 pointer, pointer, row_offset;
    add.u64 pointer, pointer, column_offset;
    ld.global.u32 value, [pointer];
    add.u32 value, value, delta;
    st.global.u32 [pointer], value;
    ret;
}
