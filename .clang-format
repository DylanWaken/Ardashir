# Unreal-style layout for project-owned C++, CUDA and HLSL. Use clang-format 19.
BasedOnStyle: Microsoft
Standard: c++17
UseTab: ForIndentation
IndentWidth: 4
TabWidth: 4
ContinuationIndentWidth: 4
AlignAfterOpenBracket: DontAlign
AlignOperands: DontAlign
NamespaceIndentation: All
AccessModifierOffset: -4
ColumnLimit: 120
BreakBeforeBraces: Allman
BreakTemplateDeclarations: Yes
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLambdasOnASingleLine: None
AllowShortLoopsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
InsertBraces: true
SeparateDefinitionBlocks: Always
MaxEmptyLinesToKeep: 1
EmptyLineBeforeAccessModifier: Always
BinPackArguments: false
BinPackParameters: false
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false
PackConstructorInitializers: Never
PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false
# Include order, comments and literal contents can have meaning; preserve them.
SortIncludes: Never
IncludeBlocks: Preserve
SortUsingDeclarations: Never
ReflowComments: false
BreakStringLiterals: false
FixNamespaceComments: false
StatementMacros:
  - ARDA_CUDA_PARAMETER_STRUCT
  - ARDA_DECLARE_GLOBAL_SHADER
  - ARDA_IMPLEMENT_GLOBAL_SHADER
  - ARDA_IMPLEMENT_GLOBAL_SHADER_WITHOUT_PARAMETERS
  - ARDA_DECLARE_LOG_CATEGORY
  - ARDA_DEFINE_LOG_CATEGORY
  - ARDA_SHADER_PARAMETER_VALUE
  - ARDA_SHADER_TEXTURE_SRV
  - ARDA_SHADER_TEXTURE_UAV
  - ARDA_SHADER_BUFFER_SRV
  - ARDA_SHADER_BUFFER_UAV
  - ARDA_SHADER_CONSTANT_BUFFER
  - ARDA_SHADER_SAMPLER
  - ARDA_SHADER_ACCEL_STRUCT
  - ARDA_COMPUTE_PARAMETER
  - ARDA_COMPUTE_BUFFER
  - ARDA_COMPUTE_TEXTURE
  - ARDA_COMPUTE_PARAMETER_STRUCT
  - ARDA_NODE_PARAMETER
  - ARDA_NODE_PARAMETER_WITH_DEFAULT
  - ARDA_NODE_STAGE_INPUT
  - ARDA_NODE_STAGE_INPUTS
  - ARDA_NODE_BUFFER
  - ARDA_NODE_TEXTURE
  - ARDA_NODE_ACCELERATION_STRUCTURE
  - ARDA_NODE_COLOR_TARGET
  - ARDA_NODE_COLOR_TARGET_ACCESS
  - ARDA_NODE_DEPTH_TARGET
  - ARDA_NODE_SHADER_BUFFER
  - ARDA_NODE_SHADER_TEXTURE
  - ARDA_NODE_SHADER_BUFFER_ACCESS
  - ARDA_NODE_SHADER_TEXTURE_ACCESS
  - ARDA_NODE_SHADER_BUFFER_BINDING
  - ARDA_NODE_SHADER_TEXTURE_BINDING
  - ARDA_NODE_SHADER_ACCELERATION_STRUCTURE
  - ARDA_NODE_SHADER_BUFFER_ARRAY
  - ARDA_NODE_SHADER_TEXTURE_ARRAY
  - ARDA_NODE_CUDA_BUFFER
  - ARDA_NODE_CUDA_TEXTURE
  - ARDA_SHADER_BUFFER_UAV_ACCESS
  - ARDA_SHADER_TEXTURE_UAV_ACCESS
  - ARDA_SHADER_BUFFER_UAV_ARRAY_ACCESS
  - ARDA_SHADER_TEXTURE_UAV_ARRAY_ACCESS
MacroBlockBegin: '^ARDA_BEGIN_(SHADER|COMPUTE|NODE)_PARAMETER_STRUCT$'
MacroBlockEnd: '^ARDA_END_(SHADER|COMPUTE|NODE)_PARAMETER_STRUCT$'
